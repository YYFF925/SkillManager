{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Manager",
  "mainBinaryName": "skill-manager-desktop",
  "version": "0.1.1",
  "identifier": "com.fei.skillmanager",
  "build": {
    "beforeDevCommand": "npm run prepare:cli && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:cli -- --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Skill Manager",
        "width": 1720,
        "height": 1040,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "externalBin": [
      "binaries/skill-manager"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2NjQwQzgzREQ2QzEzNzAKUldSd0UyemRnd3hrTmgrbFpuTndsT0d2c2lkREdwV0s3cG05VVdjUDFqRzQxTHA1TllEM28xckYK",
      "endpoints": [
        "https://github.com/YYFF925/SkillManager/releases/download/updater-manifests/latest-{{target}}-{{arch}}.json"
      ]
    }
  }
}
